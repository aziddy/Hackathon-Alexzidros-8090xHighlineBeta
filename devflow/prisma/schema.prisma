// DevFlow Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  projects Project[]
}

model Project {
  id              String    @id @default(cuid())
  name            String
  description     String?
  githubRepoOwner String
  githubRepoName  String
  githubRepoId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastSyncedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  issues Issue[]

  @@unique([userId, githubRepoOwner, githubRepoName])
}

model Issue {
  id              String      @id @default(cuid())
  title           String
  body            String?
  githubIssueId   String
  githubNumber    Int
  githubUrl       String
  status          IssueStatus @default(TODO)
  labels          String? // JSON array
  assignees       String? // JSON array
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Computed/synced fields
  progressPercent Int     @default(0)
  linkedPrNumber  Int?
  linkedPrUrl     String?
  linkedPrState   String? // "open", "merged", "closed"
  pipelineStatus  String? // "success", "failure", "pending"
  metadata        String? // JSON for branch info and other metadata

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  atomicSteps AtomicStep[]

  @@unique([projectId, githubIssueId])
}

model AtomicStep {
  id          String      @id @default(cuid())
  name        String
  description String?
  type        StepType
  checkMethod CheckMethod @default(MCP_OR_MANUAL)
  order       Int
  status      StepStatus  @default(PENDING)
  completedAt DateTime?
  verifiedVia String? // "github_api", "manual", "mcp"
  metadata    String? // JSON for additional data
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, order])
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum StepType {
  CREATE_BRANCH
  PULL_BRANCH
  CODE
  TEST
  RUN_TESTS
  COMMIT
  CREATE_PR
  REQUEST_REVIEW
  ADDRESS_COMMENTS
  GET_APPROVAL
  MERGE
  DEPLOY
  CLOSE_ISSUE
  CUSTOM
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  SKIPPED
}

enum CheckMethod {
  MCP_OR_MANUAL // Verified via IDE or manual confirmation
  MCP           // Only verifiable via IDE
  MANUAL        // Only manual confirmation
  MCP_OR_API    // Via IDE or GitHub API
  API           // Only GitHub API
}
