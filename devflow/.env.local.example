# DevFlow Environment Variables
# Copy this file to .env.local and fill in your values

# Database (SQLite - no changes needed for local development)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="your-generated-secret-here"
AUTH_URL="http://localhost:3000"

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Cerebras AI API
# Get your key at: https://cloud.cerebras.ai
CEREBRAS_API_KEY="your-cerebras-api-key"

# Testing - GitHub API Integration Tests
# Find your user ID by running: npm run db:studio (User table)
TEST_USER_ID_GITHUB_API="your-user-id-from-database"

# Optional: Specify a specific repository for testing
TEST_REPO_OWNER="your-github-username"
TEST_REPO_NAME="your-test-repo"

# Optional: Specify a specific issue number for testing
TEST_ISSUE_NUMBER=1
